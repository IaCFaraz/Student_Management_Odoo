<odoo>

    <!-- TREE VIEW -->
    <record id="view_course_tree" model="ir.ui.view">
        <field name="name">student.course.tree</field>
        <field name="model">student.course</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name"/>
                <field name="code"/>
            </tree>
        </field>
    </record>

    <!-- FORM VIEW -->
    <record id="view_course_form" model="ir.ui.view">
        <field name="name">student.course.form</field>
        <field name="model">student.course</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="code"/>
                        <field name="description"/>
                    </group>
                    <field name="student_ids"/>
                </sheet>
            </form>
        </field>
    </record>

    <!-- ACTION -->
    <record id="action_course" model="ir.actions.act_window">
        <field name="name">Courses</field>
        <field name="res_model">student.course</field>
        <field name="view_mode">tree,form</field>
    </record>

    <!-- MENU -->
    <menuitem id="menu_course_list"
              name="Courses"
              parent="menu_student"
              action="action_course"/>

</odoo>