<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- REPORT ACTION -->
    <record id="action_report_student" model="ir.actions.report">
        <field name="name">Student Report</field>
        <field name="model">student.student</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">student_management.report_student_template</field>
        <field name="report_file">student_management.report_student_template</field>
        <field name="binding_model_id" ref="model_student_student"/>
        <field name="binding_type">report</field>
    </record>

    <!-- REPORT TEMPLATE -->
    <template id="report_student_template">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="doc">
                <t t-call="web.external_layout">
                    <div class="page">

                        <!-- HEADER -->
                        <div class="text-center mb-4">
                            <h2 style="color:#7C3AED;">Student Management System</h2>
                            <h4>Student Detail Report</h4>
                            <hr/>
                        </div>

                        <!-- STUDENT INFO -->
                        <div class="row mt-4">
                            <div class="col-6">
                                <table class="table table-bordered">
                                    <tr>
                                        <th style="background-color:#7C3AED; color:white;">Field</th>
                                        <th style="background-color:#7C3AED; color:white;">Details</th>
                                    </tr>
                                    <tr>
                                        <td><strong>Student Name</strong></td>
                                        <td><t t-esc="doc.name"/></td>
                                    </tr>
                                    <tr>
                                        <td><strong>Father Name</strong></td>
                                        <td><t t-esc="doc.father_name"/></td>
                                    </tr>
                                    <tr>
                                        <td><strong>Mother Name</strong></td>
                                        <td><t t-esc="doc.mother_name"/></td>
                                    </tr>
                                    <tr>
                                        <td><strong>Date of Birth</strong></td>
                                        <td><t t-esc="doc.dob"/></td>
                                    </tr>
                                    <tr>
                                        <td><strong>Gender</strong></td>
                                        <td><t t-esc="doc.gender"/></td>
                                    </tr>
                                    <tr>
                                        <td><strong>Roll No</strong></td>
                                        <td><t t-esc="doc.roll_no"/></td>
                                    </tr>
                                    <tr>
                                        <td><strong>Admission No</strong></td>
                                        <td><t t-esc="doc.admission_no"/></td>
                                    </tr>
                                    <tr>
                                        <td><strong>Course</strong></td>
                                        <td><t t-esc="doc.course_id.name"/></td>
                                    </tr>
                                </table>
                            </div>
                        </div>

                    </div>
                </t>
            </t>
        </t>
    </template>

</odoo>