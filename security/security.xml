<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- CATEGORY -->
    <record id="module_student_management" model="ir.module.category">
        <field name="name">Student Management</field>
        <field name="description">Manage Students and Courses</field>
        <field name="sequence">1</field>
    </record>

    <!-- MANAGER ROLE -->
    <record id="group_student_manager" model="res.groups">
        <field name="name">Manager</field>
        <field name="category_id" ref="module_student_management"/>
        <field name="comment">Full access — add, edit, delete students and courses</field>
    </record>

    <!-- USER ROLE -->
    <record id="group_student_user" model="res.groups">
        <field name="name">User</field>
        <field name="category_id" ref="module_student_management"/>
        <field name="comment">Can view and edit students only — no delete, no courses</field>
    </record>

</odoo>